# Copy to .env.local and adjust for your environment.
#
# Without this the axios client in lib/api.ts has an undefined baseURL, so
# every request resolves against the admin app's own origin and 404s.

# Django API base URL, used by the browser-side axios client. Must include
# the version prefix -- request paths are written relative to it.
# Read at build time; a production build fails without it.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
